# ============================================
# OpenAI Mode (default)
# ============================================
OPENAI_API_KEY=
MODEL_NAME="gpt-realtime"

# ============================================
# Claude Mode (use with --claude flag)
# ============================================
ANTHROPIC_API_KEY=

# Claude model to use (claude-haiku-3.5, claude-sonnet-4-20250514, claude-opus-4-5-20251101)
CLAUDE_MODEL="claude-sonnet-4-20250514"

# Google Cloud credentials (required for Claude mode)
# Set this to the path of your service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Google Cloud STT settings
GOOGLE_STT_LANGUAGE="en-US"

# Google Cloud TTS settings
# See available voices: https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_VOICE="en-US-Neural2-F"
GOOGLE_TTS_LANGUAGE="en-US"

# ============================================
# Vision Settings
# ============================================
# Local vision model (only used with --local-vision CLI flag)
# By default, vision is handled by gpt-realtime when the camera tool is used
LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct

# Cache for local VLM (only used with --local-vision CLI flag)
HF_HOME=./cache

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# ============================================
# Profile Settings
# ============================================
# To select a specific profile with custom instructions and tools
REACHY_MINI_CUSTOM_PROFILE="example"